# Optional overrides. Production uses these public defaults when values are omitted.
VITE_GOOGLE_SHEET_ID=1EUhk_-_uWbQkyMQkdimEscjaun1v7lgWm5f5XDWYlo0
VITE_GOOGLE_SHEET_TAB=Main
VITE_GOOGLE_SHEET_GID=0

# Optional image base override. By default the app resolves filenames against
# `${import.meta.env.BASE_URL}portfolio/`, e.g. /Portfolio_Test/portfolio/ on GitHub Pages.
VITE_PORTFOLIO_IMAGE_BASE_URL=/Portfolio_Test/portfolio/

# Local-only demo mode. Production does not need this because the public Sheet is the default.
VITE_USE_DEMO_DATA=false
